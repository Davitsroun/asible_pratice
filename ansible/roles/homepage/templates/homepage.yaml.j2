apiVersion: v1
kind: Namespace
metadata:
  name: {{ homepage_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage
  namespace: {{ homepage_namespace }}
  labels:
    app.kubernetes.io/name: homepage
data:
  settings.yaml: |
    title: Ansible Lab Homepage
    headerStyle: clean
  services.yaml: |
    - Lab:
        - Homepage Docs:
            href: https://gethomepage.dev/
            description: Official docs
        - Kubernetes:
            href: https://kubernetes.io/
            description: k3s cluster
  widgets.yaml: |
    - search:
        provider: google
        target: _blank
  bookmarks.yaml: |
    - Developer:
        - Github:
            href: https://github.com/
  docker.yaml: ""
  kubernetes.yaml: |
    mode: disabled
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: {{ homepage_namespace }}
  labels:
    app.kubernetes.io/name: homepage
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: homepage
  template:
    metadata:
      labels:
        app.kubernetes.io/name: homepage
    spec:
      containers:
        - name: homepage
          image: {{ homepage_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: HOMEPAGE_ALLOWED_HOSTS
              value: "{{ homepage_allowed_hosts }}"
            - name: PORT
              value: "3000"
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          volumeMounts:
            - name: homepage-config
              mountPath: /app/config/settings.yaml
              subPath: settings.yaml
            - name: homepage-config
              mountPath: /app/config/services.yaml
              subPath: services.yaml
            - name: homepage-config
              mountPath: /app/config/widgets.yaml
              subPath: widgets.yaml
            - name: homepage-config
              mountPath: /app/config/bookmarks.yaml
              subPath: bookmarks.yaml
            - name: homepage-config
              mountPath: /app/config/docker.yaml
              subPath: docker.yaml
            - name: homepage-config
              mountPath: /app/config/kubernetes.yaml
              subPath: kubernetes.yaml
            - name: homepage-logs
              mountPath: /app/config/logs
            - name: homepage-images
              mountPath: /app/public/images
          startupProbe:
            tcpSocket:
              port: http
            failureThreshold: 30
            periodSeconds: 5
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
      volumes:
        - name: homepage-config
          configMap:
            name: homepage
        - name: homepage-logs
          emptyDir: {}
        - name: homepage-images
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: homepage
  namespace: {{ homepage_namespace }}
  labels:
    app.kubernetes.io/name: homepage
spec:
  type: {{ homepage_service_type }}
  ports:
    - port: 3000
      targetPort: http
      protocol: TCP
      name: http
{% if homepage_service_type == 'NodePort' and homepage_node_port | int > 0 %}
      nodePort: {{ homepage_node_port | int }}
{% endif %}
  selector:
    app.kubernetes.io/name: homepage
