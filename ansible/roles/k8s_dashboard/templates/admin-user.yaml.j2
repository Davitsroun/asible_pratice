apiVersion: v1
kind: ServiceAccount
metadata:
  name: admin-user
  namespace: {{ k8s_dashboard_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kubernetes-dashboard-admin-user
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: admin-user
    namespace: {{ k8s_dashboard_namespace }}
---
# Expose Dashboard UI on NodePort for lab access
apiVersion: v1
kind: Service
metadata:
  name: kubernetes-dashboard-nodeport
  namespace: {{ k8s_dashboard_namespace }}
  labels:
    k8s-app: kubernetes-dashboard
spec:
  type: NodePort
  ports:
    - port: 443
      targetPort: 8443
      nodePort: {{ k8s_dashboard_node_port | int }}
      protocol: TCP
      name: https
  selector:
    k8s-app: kubernetes-dashboard
